# NO INTRODUZCAS SECRETOS REALES AQUÍ
META_VERIFY_TOKEN=GENERAR_TOKEN_ALEATORIO_LARGO
META_APP_SECRET=SECRETO_APP_META
META_PHONE_NUMBER_ID=ID_DE_NUMERO_DE_META
META_ACCESS_TOKEN=TOKEN_PERMANENTE_DE_META
